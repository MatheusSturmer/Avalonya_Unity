  - id: vitalidade
    titulo: VITALIDADE
    descricao: "+2 de vida m\xE1xima\ne recupera 2 de vida."
    imagem: {fileID: 21300000, guid: e14f2b0417d3242158c7f319e4f22fb5, type: 3}
